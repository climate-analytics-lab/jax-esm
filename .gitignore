# The 0.25-degree bathymetry intermediate the packaged bathymetry is rebuilt from.
!tests/unit/data/*.nc

# What `python -m jem.main` writes when it is run from the repo root: Hydra's
# default run directory is outputs/<date>/<time>/, holding main.log, .hydra/,
# the netCDF output and checkpoint/.
outputs/

# Figures the example notebooks write next to themselves, in
# examples/<group>/output/<notebook name>/. `examples/clean_notebooks.py`
# already treats these directories as generated (it skips them when clearing
# notebook outputs); they are regenerated by running the notebook.
examples/**/output/
