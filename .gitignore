# Output written by the example drivers alongside themselves:
# examples/<group>/<example>/output_T<truncation>/<run name>/ holds the netCDF
# output, a checkpoint/ directory (component pickles and Veros HDF5 restarts)
# and the explosion log. Each Veros run.sh deletes its own before running;
# these rules keep whatever a manual or interrupted run leaves behind out of
# the index.
output_T*/
explode.log

# Figures the example notebooks write next to themselves, in
# examples/<group>/output/<notebook name>/. `examples/clean_notebooks.py`
# already treats these directories as generated (it skips them when clearing
# notebook outputs); they are regenerated by running the notebook.
examples/**/output/
